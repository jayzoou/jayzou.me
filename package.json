{
  "name": "jayzou.me",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-static build && node scripts/enrich-html.mjs",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run check:env && npm run lint && npm run typecheck && npm run test:checks && npm run build && npm run check:content && npm run check:performance && npm run test:e2e",
    "preinstall": "node scripts/check-env.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:content": "node scripts/check-content.mjs",
    "test:checks": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "check:performance": "node scripts/check-performance.mjs"
  },
  "dependencies": {
    "mermaid": "^10.4.0",
    "ml5": "^1.3.1",
    "motion": "^12.15.0",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@mdx-js/react": "^2.3.0",
    "@mdx-js/rollup": "^3.1.0",
    "@playwright/test": "^1.65.1",
    "@shikijs/rehype": "3.21.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "katex": "^0.16.8",
    "parse5": "^8.1.1",
    "patch-package": "^8.0.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "shiki": "3.21.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "unist-util-visit": "^5.2.0",
    "unocss": "^66.1.0-beta.11",
    "vite": "^6.2.0",
    "vite-react-static": "0.1.2"
  },
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10.9.7 <11"
  },
  "packageManager": "npm@10.9.7"
